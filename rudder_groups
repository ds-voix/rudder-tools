#!/usr/bin/python3

import argparse
import json
import os
import re
import sys
#import time

sys.path.append("%s/%s" % (os.path.dirname(__file__), "common"))
from colors import *

RUDDER=''
DST_RUDDER=''
SRC=''
DST= ''
GROUP=''
# Retry unsuccessful attempts
HTTP_TIMEOUT = 5
API = None

from json_api import *
from rudder import *


def usage():
  exe = os.path.basename(__file__)
  print(f"""{cm}  Usage:{c_} {sb}{exe}{s_} <src_rudder.url> <"Path/to/group to be replicated"> <dst_rudder.url>

{sb}{exe}{s_} <src_rudder.url> -- List all groups with their full path in group tree
{sb}{exe}{s_} <src_rudder.url> rules -- List all rules with their full path in rule tree""")
  sys.exit(0)


def list_groups():
  ok, groups = retry(API.get_json, "/groups/tree")
  if not ok:
    sys.exit(1)

  print_groups(groups["data"]["groupCategories"], '')

  sys.exit(0)


# The extra feature to list the rule tree "in place".
def list_rules():
  API = JSON_API(SRC, DST, HTTP_TIMEOUT)
  ok, rules = retry(API.get_json, "/rules/tree")
  if not ok:
    sys.exit(1)

  print_rules(rules["data"]["ruleCategories"], '')

  sys.exit(0)


def main():
  ok, groups = retry(API.get_json, "/groups/tree")
  if not ok:
    sys.exit(1)

  # Update groups only for the existing rules.
  ok, rules = retry(API.get_json, "/rules")
  if not ok:
    sys.exit(1)

  ok, dst_groups = retry(API.get_json, "/groups/tree", DST)
  if not ok:
    sys.exit(1)

  ok, dst_rules = retry(API.get_json, "/rules", DST)
  if not ok:
    sys.exit(1)

#  print("%s" % json.dumps(groups["data"]["groupCategories"]["categories"]))
#  print(GROUP[1])

  GC=[] # Array of dictionaries
  GR={} # Group object
  RULES={} # SRC rules containing the group
  if len(GROUP) == 1: # "Root of the group and group categories"
    cat = groups["data"]["groupCategories"]
    group = groups["data"]["groupCategories"]["groups"]
    gr = rudder_groups(group, GROUP[0])
    g = GROUP[0]
    print("(%s)" % cat["id"])
  else:
    cat = groups["data"]["groupCategories"]["categories"]
    for i, g in enumerate(GROUP):
      if i < len(GROUP) - 1:
        cat = rudder_categories(cat, g)
        if cat:
          print("+ %s" % g)
          GC.append({"parent": cat["parent"],
                     "id": cat["id"], #  Default: "{autogenerated}"
                     "name": cat["name"],
                     "description": cat["description"]})
        else:
          print("- %s" % g)
          sys.exit(1)
      else:
        group = cat["groups"]
        gr = rudder_groups(group, GROUP[len(GROUP) - 1])

  if gr:
    print("+ %s" % g)
    GR = {"category": cat["id"],
          "id": gr["id"], #  Default: "{autogenerated}"
          "displayName": gr["displayName"],
          "description": gr["description"],
          "query": gr["query"],
          "dynamic": gr["dynamic"],
          "enabled": gr["enabled"]}
### Newer rudders ###
#              "properties":  gr["properties"]}
  else:
    print("- %s" % g)
    sys.exit(1)
#  print(GC)
#  print(GR)

  ### Replica to DST ###
  cat = dst_groups["data"]["groupCategories"]
  category = cat["id"]

  for g in GC:
    cat = rudder_categories(cat["categories"], g["name"])
    if cat:
      category = cat["id"]
    else:
      ok, res = retry(API.put_json, "/groups/categories", g)
      if not ok:
        sys.exit(1)
      if not "data" in res:
        sys.exit(1)
      res = res["data"]
      if not "groupCategories" in res:
        sys.exit(1)
      res = res["groupCategories"]
      if not "id" in res:
        sys.exit(1)
      category = res["id"]

  GR["category"] = category

  group = cat["groups"]
  gr = rudder_groups(group, GROUP[len(GROUP) - 1])
  if gr:
    # POST the update
    ok, res = retry(API.put_json, "/groups/%s" % gr["id"], GR, 'POST')
    if not ok:
      sys.exit(1)
  else:
    # PUT new
    ok, res = retry(API.put_json, "/groups", GR)
    if not ok:
      sys.exit(1)

    gr = {}
    gr["id"] = GR["id"]

  print(f"{cg}%s :: OK{c_}" % '/'.join(GROUP))

  print("Updating rules")
  srcg = "group:%s" % GR["id"]
  dstg = "group:%s" % gr["id"]
  print(f"{srcg} >> {dstg}")

  rrr = rules["data"]["rules"]
  for r in rrr:
    include = rule_group(r["targets"], srcg)
    if include:
      RULES[r["displayName"]] = include

  for r, include in sorted(RULES.items(), key=lambda kv: (kv[1], kv[0])): # "exclude" prior to "include"
    dst, targets = rule_by_name(dst_rules["data"]["rules"], r)
    if dst:
      if not dstg in targets[0][include]["or"]:
        targets[0][include]["or"].append(dstg)
      if dstg in targets[0][invert(include)]["or"]: # Rudder allows both include and exclude for the same group. Fix it!
        targets[0][invert(include)]["or"].remove(dstg)

#      targets[0][invert(include)]["or"].append(dstg) # Hack it!
#      print(r, dst, targets)

      rule = {"targets": targets}
      # POST the update
      ok, res = retry(API.put_json, "/rules/%s" % dst, rule, 'POST')
      if not ok:
        sys.exit(1)
      print(f"Rule: \"{r}\"")


if __name__ == '__main__':
  if len(sys.argv) == 1:
    usage()

  RUDDER = sys.argv[1]
  SRC = 'https://%s:8443/rudder/api/latest' % RUDDER
  if len(sys.argv) == 2:
    API = JSON_API(SRC, None, HTTP_TIMEOUT)
    list_groups()

  if len(sys.argv) == 3:
    if sys.argv[2].lower() == "rules":
      API = JSON_API(SRC, None, HTTP_TIMEOUT)
      list_rules()
    else:
      usage()

  GROUP = sys.argv[2].split("/")
  if len(sys.argv) < 4:
    usage()

  DST_RUDDER = sys.argv[3]
  DST = 'https://%s:8443/rudder/api/latest' % DST_RUDDER

  API = JSON_API(SRC, DST, HTTP_TIMEOUT)

###################### Exclusive running ######################
  import fcntl
  lock_file = "/var/lock/rudder_groups.%s--%s" % (RUDDER, DST_RUDDER)
  locked = 0
  try:
    # Not so strong, as file can be removed outside of process
    lck = open(lock_file, 'w')
    # But, better then nothing
    fcntl.lockf(lck, fcntl.LOCK_EX | fcntl.LOCK_NB)
    locked = 1
    main()

  except EnvironmentError as err:
    if lck is not None:
      print(f"Another instance is running! Lock found on \"{lock_file}\"")
      sys.exit(1)
    else:
      raise

  finally:
    if locked > 0:
      os.remove(lock_file)

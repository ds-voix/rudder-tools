# Pick categories and the rule from tree, accordong to full path in "RULE" string
def rule_from_path(RULE, rules):
  RC=[] # Array of dictionaries

  if len(RULE) == 1: # "rootRuleCategory"
    cat = rules["data"]["ruleCategories"]
    rule = rules["data"]["ruleCategories"]["rules"]
    rr = rudder_rules(rule, RULE[0])
    r = RULE[0]
    print(f"(%s): {r}" % cat["id"])
  else:
    cat = rules["data"]["ruleCategories"]
    for i, r in enumerate(RULE):
      if i < len(RULE) - 1:
        cat = rudder_categories(cat["categories"], r)
        if cat:
          print("o %s" % r)
          RC.append({"parent": cat["parent"],
                     "id": cat["id"], #  Default: "{autogenerated}"
                     "name": cat["name"],
                     "description": cat["description"]})
        else:
          print("- %s" % r)
          return None, RC
      else:
        rule = cat["rules"]
        rr = rudder_rules(rule, RULE[len(RULE) - 1])

  if rr:
    print("o %s " % r)
  else:
    print("- %s " % r)
  return rr, RC

# Rename rule and it's directives using prefix
def rule_rename(RR, directives):
  renamed = {}
  for d in RR["directives"]:
    dd = directive_by_id(directives, d)
    if not dd:
      print(f"{cr}{rudder} (rule_rename):{c_} Directive with id={id} not found")
      return None

    new_name = dd['displayName']
    if ARGS.Prefix != "":
      if new_name.find(ARGS.Prefix) == 0:
        continue
      new_name = ARGS.Prefix + dd['displayName']
    else: # Try to drop the default prefix
      prefix = "#old "
      while new_name.find(prefix) == 0:
        new_name = new_name[len(prefix):]

    if dd['displayName'] != new_name:
      renamed[dd['displayName']] = new_name
      dd['displayName'] = new_name
      # POST the update
      ok, res = retry(API.put_json, "/directives/%s" % d, dd, 'POST')
      if not ok:
        print(f"- {new_name}")
        return None

      print(f"+ {new_name}")

  # Now, rename the rule
  new_name = RR['displayName']
  if ARGS.Prefix != "":
    if new_name.find(ARGS.Prefix) < 0:
      new_name = ARGS.Prefix + RR['displayName']
  else: # Try to drop the default prefix
    prefix = "#old "
    while new_name.find(prefix) == 0:
      new_name = new_name[len(prefix):]

  if RR['displayName'] != new_name:
#    renamed[dd['displayName']] = new_name
    RR['displayName'] = new_name
    # POST the update
    ok, res = retry(API.put_json, "/rules/%s" % RR['id'], RR, 'POST')
    if not ok:
      return None

    print(f"+ RULE {new_name}")

  return renamed


# Delete rule and it's directives
def rule_delete(RR, directives):
  if ARGS.Prefix == "":
    return None

  for d in RR["directives"]:
    dd = directive_by_id(directives, d)
    if not dd:
      print(f"{cr}(rule_delete):{c_} Directive with id={d} not found")
      return None

    if dd['displayName'].find(ARGS.Prefix) < 0:
      print(f"{cr}(rule_delete):{c_} Directive with id={d} has no prefix! Abort deletion")
      return None

  if RR['displayName'].find(ARGS.Prefix) < 0:
    print(f"{cr}(rule_delete):{c_} Rule to be deleted has no prefix! Abort deletion")
    return None

  for d in RR["directives"]:
    dd = directive_by_id(directives, d)
    ok, res = retry(API.delete, "/directives/%s" % d)
    if not ok:
      return None
    else:
      print(f"+ {dd['displayName']}")

  ok, res = retry(API.delete, "/rules/%s" % RR['id'])
  if not ok:
    return None
  else:
    print(f"+ RULE \"{RR['displayName']}\"")


# Copy "targets" from old to new
def transfer_rule_groups(RR_old, RR_new):
  # Pre-fill targets
#  RR_new['targets'].append({'include': {'or': []}})
#  RR_new['targets'].append({'exclude': {'or': []}})

  if ARGS.CopyExcludeGroups == '*':
    RR_new["targets"][0]["include"]["or"] = RR_old["targets"][0]["include"]["or"]
  elif ARGS.CopyExcludeGroups != '':
    groups = CopyExcludeGroups.split(',')
    for g in groups:
      if g in RR_old["targets"][0]["include"]["or"]:
        RR_new["targets"][0]["include"]["or"].append(g)

  if ARGS.MoveGroups == '*':
    RR_new["targets"][0]["exclude"]["or"] = RR_old["targets"][0]["exclude"]["or"]
  elif ARGS.MoveGroups != '':
    groups = MoveGroups.split(',')
    for g in groups:
      if g in RR_old["targets"][0]["exclude"]["or"]:
        RR_new["targets"][0]["exclude"]["or"].append(g)

  return RR_new


def main():
  RC=[] # Array of dictionaries
  RR={} # Rule object
  SRC_DICT = {} # By id
  DST_DICT = {} # By name
  OLD_RULE = "" # The old rule UUID, to be deleted
  dst_rule_list = None

  if RUDDER:

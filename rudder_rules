    if rr:
      print("UUID: %s" % rr['id'])
      RR = rr
      del RR['id'] # Generate UUID on replication
#      del RR['targets'] # Call rudder_groups after the rule replication
      RR["targets"][0]["include"]["or"] = []
      RR["targets"][0]["exclude"]["or"] = []
#      RR = {"category": cat["id"],
#            "id": rr["id"], #  Default: "{autogenerated}"
#            "displayName": rr["displayName"],
#            "shortDescription": rr["shortDescription"],
#            "longDescription": rr["longDescription"],
#            "enabled": rr["enabled"]}
    else:
      print("- %s" % r)
      return 1



  if DST_RUDDER:
    ok, dst_rules = retry(API.get_json, "/rules/tree", DST)
    if not ok:
      return 1

    ok, dst_directives = retry(API.get_json, "/directives", DST)
    if not ok:
      return 1

    dst_directives = dst_directives["data"]["directives"]
    DST_DICT = directives_dict_by_name(dst_directives)
    print(f"{sb}{DST_RUDDER}:{s_} done loading (rules & directives) collection")

    if ARGS.FindOrphanDirectives:
      if not dst_rule_list:
        ok, dst_rule_list = retry(API.get_json, "/rules", DST)
        if not ok:
          return 1
      rules = dst_rule_list["data"]["rules"]
      DICT = {}
      for r in rules:
        for rd in r["directives"]:
          DICT[rd] = None

      print(f"{sb}{DST_RUDDER}:{s_} Orphans:")
      for d in dst_directives:
        if not d["id"] in DICT:
          if not ARGS.DeleteId: # Just list
            print("- %s >> %s" % (d["id"], d["displayName"]))
          elif ARGS.DeleteId != "*": # Delete orphans by prefix
            if d["displayName"].find(ARGS.DeleteId) != 0:
              continue
            ok, res = retry(API.delete, "/directives/%s" % d["id"])
            if not ok:
              print("- %s >> %s" % (d["id"], d["displayName"]))
              return 1
            else:
              print("+ %s >> %s" % (d["id"], d["displayName"]))

          else: # Delete all orphans
            ok, res = retry(API.delete, "/directives/%s" % d["id"])
            if not ok:
              print("- %s >> %s" % (d["id"], d["displayName"]))
              return 1
            else:
              print("+ %s >> %s" % (d["id"], d["displayName"]))

      return 0


    if ARGS.RenameId:
      print(f"{sb}{DST_RUDDER}:{s_} Renaming rule with it's directives, prefix=\"{ARGS.Prefix}\"")
      rr, _ = rule_from_path(RULE, dst_rules)

      if rr:
        renamed = rule_rename(rr, dst_directives)
        if renamed is None:
          print("Rename failed")
          return 1
        OLD_RULE = rr['id']
        for old, new in renamed.items():
          DST_DICT[new] = DST_DICT[old]
          del DST_DICT[old]
      else:
        ARGS.DeleteId = ''
        print(f"{sd}{DST_RUDDER}:{s_} Rule to be renamed was not found at the provided path. Skipping deletion as well...")


    if ARGS.SendId:
      ### Replica to DST ###
      dup = [] # There must not been the same directive names on the target
      DIRECTIVES = []
      for d in RR["directives"]:
        if SRC_DICT[d] in DST_DICT:
          dup.append(SRC_DICT[d])
        else:
          DIRECTIVES.append(SRC_DICT[d])
      if dup:
        print(f"{cr}{DST_RUDDER}:{c_} found directives with the same names:")
#        print(type(dup))
        for d in sorted(dup):
          print(f" {d}")
          return 1

      cat = dst_rules["data"]["ruleCategories"]
#      print(cat)
      category = cat["id"]

      for r in RC:
        cat = rudder_categories(cat["categories"], r["name"])
        if cat:
          category = cat["id"]
        else:
          ok, res = retry(API.put_json, "/rules/categories", r)
          if not ok:
            return 1
          if not "data" in res:
            return 1
          res = res["data"]
          if not "ruleCategories" in res:
            return 1
          res = res["ruleCategories"]
          if not "id" in res:
            return 1
          category = res["id"]
          # cat is None
          cat = {'id': category, 'name': r["name"], 'categories': []}

      RR["category"] = category

      # There must not been the same rule name on the target ruleset
      if not dst_rule_list:
        ok, dst_rule_list = retry(API.get_json, "/rules", DST)
        if not ok:
          return 1
      dup, _ = rule_by_name(dst_rule_list["data"]["rules"], RR['displayName'])
      if dup:
        print(f"{cr}{DST_RUDDER}:{c_} found the rule with the same name:")
        print(f" {dup} == \"%s\"" % RR['displayName'])
        return 1

      # Put new rule, together with it's directives
      # New directive set
      RR['directives'] = []
      print(f"{sb}{DST_RUDDER}:{s_} Writing directives")
      for name in DIRECTIVES:
        d = directive_by_name(directives, name)
        if d:
          del d['id']
          print(f"+ {name}")
          d['techniqueVersion'] = update_technique(d['techniqueName'], d['techniqueVersion'])
          ok, res = retry(API.put_json, "/directives", d)
          if not ok:
            return 1
          if not "data" in res:
            return 1
          res = res["data"]["directives"][0]
#          print(res['id'])
          RR['directives'].append(res['id'])
        else:
          print("WTF!? Directive \"{name}\" not found!")
          return 1

      # New rule
      RR_old = None
      if ARGS.RenameId and (ARGS.MoveGroups or ARGS.CopyExcludeGroups):
        if OLD_RULE:
          print(f"{sb}{DST_RUDDER}:{s_} Transferring groups")
          RR_old = rule_by_id(dst_rule_list["data"]["rules"], OLD_RULE)
          RR = transfer_rule_groups(RR_old, RR)

      ok, res = retry(API.put_json, "/rules", RR)
      if not ok:
        return 1
      if not "data" in res:
        return 1
      print(f"+ RULE {RR['displayName']}")

      if RR_old:
        print(f"{sb}{DST_RUDDER}:{s_} Desactivating the old rule")
        RR_old["targets"][0]["include"]["or"] = []
        RR_old["targets"][0]["exclude"]["or"] = []
        ok, res = retry(API.put_json, "/rules/%s" % RR_old["id"], RR_old, 'POST')
        if not ok:
          return 1
        if not "data" in res:
          return 1
        print(f"+ RULE {RR_old['displayName']}")


    if ARGS.DeleteId:
      rr = None
      if not ARGS.Prefix:
        print(f"{cr}{DST_RUDDER}:{c_} deleting of rules with an empty prefix is denied!")
        return 1

      if ARGS.DeleteId == '*':
        if OLD_RULE == "":
          if ARGS.DstInfoPath:
            RULE = ARGS.DstInfoPath.split("/")
            RULE[len(RULE)-1] = ARGS.Prefix + RULE[len(RULE)-1]
            rr, _ = rule_from_path(RULE, dst_rules)
          else:
            print(f"{cr}{DST_RUDDER}:{c_} Provide the path to destination rule to be deleted")
            return 1
      else:
        if OLD_RULE == "":
          OLD_RULE = ARGS.DeleteId

      if not rr:
        if not dst_rule_list:
          ok, dst_rule_list = retry(API.get_json, "/rules", DST)
          if not ok:
            return 1
        rr = rule_by_id(dst_rule_list["data"]["rules"], OLD_RULE)

      if rr:
        print(f"{sb}{DST_RUDDER}:{s_} Deleting (prefixed) rule \"{rr['id']}\" with it's directives, if all of them have prefix=\"{ARGS.Prefix}\"")
        rule_delete(rr, dst_directives)
      else:
        print(f"{cr}{DST_RUDDER}:{c_} (Prefixed) rule to be deleted was not found")
        return 1


